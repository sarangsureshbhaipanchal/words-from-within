<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} | WORDS FROM WITHIN</title><style>body{margin:0;background:#101010;color:#f4efe7;font:18px/1.8 Georgia,serif}.wrap{width:min(90%,820px);margin:auto}.eyebrow{color:#b79a67;text-transform:uppercase;letter-spacing:3px;font:11px Arial,sans-serif;margin-top:70px}h1{font:normal clamp(42px,7vw,72px)/1.1 Georgia,serif}.date{color:#aaa49a;font:13px Arial,sans-serif}img{max-width:100%;max-height:620px;object-fit:cover}.content{margin:45px 0 100px}.back{font:12px Arial,sans-serif;color:#b79a67}</style></head><body><main class="wrap"><div class="eyebrow">{{type}} / {{category}}</div><h1>{{title}}</h1><div class="date">{{date | date("dd MMMM yyyy")}}</div>{% if image %}<p><img src="{{image}}" alt="{{title}}"></p>{% endif %}<div class="content">{{content|safe}}</div><a class="back" href="/">← Back to Words From Within</a></main></body></html>
