<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{title}} | WORDS FROM WITHIN</title>

  <style>
    :root {
      --background: #101010;
      --text: #eee9e1;
      --muted: #aaa49a;
      --accent: #b79a67;
      --line: #2a2927;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 19px;
      line-height: 1.9;
    }

    .wrap {
      width: min(90%, 820px);
      margin: 0 auto;
      padding-bottom: 90px;
    }

    .eyebrow {
      margin-top: 75px;
      margin-bottom: 24px;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 3px;
      font: 11px/1.4 Arial, sans-serif;
    }

    h1 {
      margin: 0 0 18px;
      max-width: 780px;
      color: var(--text);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(42px, 7vw, 72px);
      font-weight: normal;
      line-height: 1.08;
      letter-spacing: -1px;
    }

    .date {
      margin-bottom: 42px;
      color: var(--muted);
      font: 13px/1.5 Arial, sans-serif;
      letter-spacing: .4px;
    }

    .featured-image {
      margin: 0 0 48px;
    }

    .featured-image img {
      display: block;
      width: 100%;
      max-height: 620px;
      object-fit: cover;
      border-radius: 2px;
    }

    .content {
      margin: 0 0 75px;
    }

    /* Font Styles */

    .font-classic-serif {
      font-family: Georgia, "Times New Roman", serif;
    }

    .font-modern {
      font-family: Arial, Helvetica, sans-serif;
    }

    .font-typewriter {
      font-family: "Courier New", Courier, monospace;
    }

    .font-poetic {
      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;
    }

    .font-elegant {
      font-family: "Palatino Linotype", Palatino, Georgia, serif;
      letter-spacing: 0.2px;
    }

    .font-hindi {
      font-family: "Noto Sans Devanagari", "Mangal", sans-serif;
      line-height: 2;
    }

    .font-gujarati {
      font-family: "Noto Sans Gujarati", "Shruti", sans-serif;
      line-height: 2;
    }

    .content p {
      margin: 0 0 28px;
    }

    .content p:first-child {
      font-size: 21px;
      line-height: 1.85;
    }

    .content strong {
      color: #f5efe6;
      font-weight: bold;
    }

    .content em {
      color: #d6cec1;
    }

    .content blockquote {
      margin: 40px 0;
      padding: 8px 0 8px 24px;
      border-left: 2px solid var(--accent);
      color: #d8d0c4;
      font-size: 21px;
      font-style: italic;
    }

    .back {
      display: inline-block;
      padding-top: 22px;
      border-top: 1px solid var(--line);
      color: var(--accent);
      text-decoration: none;
      font: 12px/1.5 Arial, sans-serif;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: opacity .2s ease;
    }

    .back:hover {
      opacity: .7;
    }

    @media (max-width: 600px) {
      body {
        font-size: 18px;
        line-height: 1.8;
      }

      .wrap {
        width: 88%;
        padding-bottom: 60px;
      }

      .eyebrow {
        margin-top: 45px;
        letter-spacing: 2px;
      }

      h1 {
        font-size: clamp(38px, 11vw, 54px);
        letter-spacing: -.5px;
      }

      .date {
        margin-bottom: 30px;
      }

      .featured-image {
        margin-bottom: 35px;
      }

      .content p:first-child {
        font-size: 19px;
      }
    }
  </style>
</head>

<body>

  <main class="wrap">

    <div class="eyebrow">
      {{type}} / {{category}}
    </div>

    <h1>{{title}}</h1>

    <div class="date">
      {{date | readableDate}}
    </div>

    {% if image %}
      <div class="featured-image">
        <img src="{{image}}" alt="{{title}}">
      </div>
    {% endif %}

    <article class="content font-{{ fontStyle | default('Classic Serif') | lower | replace(' ', '-') }}">
      {{content|safe}}
    </article>

    <a class="back" href="/">
      ← Back to Words From Within
    </a>

  </main>

</body>
</html>