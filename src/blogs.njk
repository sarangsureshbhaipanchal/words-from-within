---
layout: page.njk
permalink: /blogs/
---

<section>

  <div class="wrap">

    <div class="eyebrow">
      Words From Within
    </div>

    <h1>
      Blogs
    </h1>

    <p class="muted">
      Stories, thoughts and observations from life.
    </p>

    <div class="posts">

      {% for post in collections.blogs %}

        <article class="blog">

          {% if post.data.image %}

            <img
              src="{{ post.data.image }}"
              alt="{{ post.data.title }}"
            >

          {% endif %}

          <div class="num">
            BLOG · {{ post.date | readableDate }}
          </div>

          <h3>
            <a href="{{ post.url }}">
              {{ post.data.title }}
            </a>
          </h3>

          <p class="muted">

            {{ post.templateContent
              | cleanExcerpt
              | truncate(180)
            }}

          </p>

          <a
            href="{{ post.url }}"
            class="btn"
          >
            Read More
          </a>

        </article>


      {% else %}

        <p class="muted">
          No blogs published yet.
        </p>

      {% endfor %}

    </div>

  </div>

</section>